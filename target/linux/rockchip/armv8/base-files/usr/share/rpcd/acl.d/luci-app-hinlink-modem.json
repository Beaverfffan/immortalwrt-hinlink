{
	"luci-app-hinlink-modem": {
		"description": "HinLink 5G 模组控制（rfkill 软复位 / 状态查询）",
		"read": {
			"ubus": {
				"hinlink-modem": [ "status" ]
			},
			"uci": [ "hinlink-modem" ]
		},
		"write": {
			"ubus": {
				"hinlink-modem": [ "reset", "power_off", "power_on", "usb_reset" ]
			},
			"uci": [ "hinlink-modem" ]
		}
	}
}
