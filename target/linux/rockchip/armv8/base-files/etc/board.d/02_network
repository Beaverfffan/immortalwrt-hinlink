#!/bin/sh /lib/ucode/luci

# HinLink 机型网络配置
#
# 每机型独立分支，映射写死，不做自适应探测。
# 依据：厂商 2022/2023/2024 固件的 board.d/02_network 原文
#
# 命名对照（厂商曾用过的 compatible 前缀）：
#   hinlink,opc-h68k-a / -c      2022 五改型（a-b / c-d / c-d-f / c-usb3）
#   hinlink,opc-h68k-d            2023.4 推荐版
#   hinlink,opc-h68k-new          2023末~2024（与 H69K 共底板，不涉及 SATA/USB3 复用）
#   hinlink,opc-h69k              装 USB 5G 模组的真 69K，**三网口**
#   hinlink,opc-h69k-mini         **四网口**（= H68K max），不涉及 SATA/USB3 复用
#
# ★ SATA 变体（仅 2022-2023 老机器 a-b / c / d）：
#   后缀 -sata，combphy0 让给 SATA，USB3.0 不可用。网口映射与基础版相同。
#
# 网口枚举前提（immortalwrt 6.18 内核 dtc顺序）：
#   gmac0     -> eth0   (SoC 内部控制器，顺序固定)
#   gmac1     -> eth1   (SoC 内部控制器，顺序固定)
#   rtl8125_1 -> eth2   (PCIe，按 PCI 扫描顺序)
#   rtl8125_2 -> eth3   (PCIe)
# ⚠️ 若某机型无 pcie-eth，则不存在 eth2/eth3，下方映射已按实际配置写死。


case "$board" in

# ---- H68K A/B：2022 双千兆版，仅 2 个口----

hinlink,opc-h68k-a|\
	hinlink,opc-h68k-a-sata|\
	linkstar,opc-h68k-a)
		ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
		;;


# ---- H68K C/D/F：2022 四网口版，2×RTL8125 ----

hinlink,opc-h68k-c|\
	hinlink,opc-h68k-c-sata|\
	linkstar,opc-h68k-c)
		ucidef_set_interfaces_lan_wan 'eth0 eth2 eth3' 'eth1'
		;;


# ---- H68K C USB3：2022 四网口 + USB3 ----

hinlink,opc-h68k-c-usb3)
		ucidef_set_interfaces_lan_wan 'eth0 eth2 eth3' 'eth1'
		;;


# ---- H68K D：2023.4 推荐版，WAN = eth0（网口全识别）----

hinlink,opc-h68k-d|\
	hinlink,opc-h68k-d-sata|\
	linkstar,opc-h68k-d)
		ucidef_set_interfaces_lan_wan 'eth1 eth2 eth3' 'eth0'
		;;


# ---- H68K new：2023末~2024 现行版 ----

hinlink,opc-h68k-new)
		ucidef_set_interfaces_lan_wan 'eth1 eth2 eth3' 'eth0'
		;;


# ---- H69K：三网口（屏蔽 gmac1，保留 2 路 RTL8125）----
# eth0 = gmac0（板载 RGMII）；eth2/eth3 = 两路 PCIe 2.5G
# aliases ethernet0 = &gmac0 => 板载口是 eth0

hinlink,opc-h69k)
		ucidef_set_interfaces_lan_wan 'eth1 eth2' 'eth0'
		;;


# ---- H69K-mini：四网口（= H68K max）----
# 网络构成与 H69K 相同（1×GMAC + 2×RTL8125），口数相同；
# 差异在形态与 5G 模组，不在网口数量。

hinlink,opc-h69k-mini)
		ucidef_set_interfaces_lan_wan 'eth1 eth2' 'eth0'
		;;


# ---- H66K：无板载网口，单口 ----

hinlink,h66k)
		ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
		;;


# ---- H28K：RK3528，双口 ----

hinlink,h28k)
		ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
		;;


	*)
		;;
esac


# 从 eMMC CID 生成稳定的 MAC
case "$board" in
hinlink,opc-h68k-a|\
hinlink,opc-h68k-a-sata|\
hinlink,opc-h68k-c|\
hinlink,opc-h68k-c-sata|\
hinlink,opc-h68k-c-usb3|\
hinlink,opc-h68k-d|\
hinlink,opc-h68k-d-sata|\
hinlink,opc-h68k-new|\
hinlink,opc-h69k|\
hinlink,opc-h69k-mini|\
hinlink,h68k|\
hinlink,h66k|\
hinlink,h28k|\
linkstar,h28k|\
hinlink,opc-h29k|\
hinlink,h29k-v1.3|\
hinlink,h29k-v1.3-114|\
hinlink,h29k-v5|\
hinlink,h29k-v5-114|\
hinlink,h29k-v5-1.49|\
hinlink,h29k-v5-28)
		wan_mac=$(macaddr_generate_from_mmc_cid mmcblk0)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		;;
esac

# ---- RK3528 机型 ----

hinlink,opc-h28k|\
	linkstar,h28k)
		# H28K：PCIe RTL8111HS 为eth0，板载 RGMII 为 eth1
		ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
		;;

hinlink,opc-h29k|\
	hinlink,h29k-v1.3|\
	hinlink,h29k-v1.3-114|\
	hinlink,h29k-v5|\
	hinlink,h29k-v5-114|\
	hinlink,h29k-v5-1.49|\
	hinlink,h29k-v5-28)
		# H29K 全系（含 v1.3 / v5 各屏）：板载 RGMII 为 eth0（aliases ethernet0=&gmac1），PCIe 为 eth1
		ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
		;;

hinlink,opc-ht2)
		# HT2：板载 RGMII 为 eth0，PCIe 为 eth1
		ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
		;;

# ---- RK3588 机型 ----

hinlink,h88k-v2|\
	hinlink,h88k-v3)
		# H88K：1×RGMII + 2×PCIe，WAN 走 RGMII
		ucidef_set_interfaces_lan_wan 'eth1 eth2 eth3' 'eth0'
		;;
