#!/bin/sh /lib/ucode/luci

# HinLink 机型网络配置
#
# ★ 本文件的用法：由 tools/integrate.py 把下面 **两个** case 块的内容
#   按顺序插进官方 02_network 的 rockchip_setup_interfaces() 与
#   rockchip_setup_macs() 里（各插在官方 `*)` 兜底**之前**）。
#   所以本文件必须满足：
#     1. **两个** `case "$board" in` 块，顺序 = 接口映射 → MAC 生成
#     2. **不要**写 `*)` 兜底（会把官方其他机型吃掉）
#     3. 不要写 board_config_* / exit 0（官方文件里已有）
#   本文件同时也是一份**可独立运行**的合法脚本（便于本地校验）。
#
# 依据：厂商固件 board.d/02_network 原文（fw22 fw1-fw3 / fw23 / fw29new / fw89k）
#       + 上游 openwrt armv8/base-files/etc/board.d/02_network
#
# 网口枚举（immortalwrt 6.18，按 DTS alias 顺序）：
#   RK3568: gmac0=eth0  gmac1=eth1  pcie3x1(2.5G)=eth2  pcie3x2(2.5G)=eth3
#   RK3528: gmac1=eth0（单口）
#   RK3588: gmac0=eth0  pcie2x1l1=eth1  pcie2x1l2=eth2
#
# ★ H68K 的 WAN 口位置随固件代次变化（这是厂商自己改的，不是硬件差异）：
#     2022 固件（fw22）      -a: WAN=eth0        -c: WAN=eth1
#     2023 固件（fw23）      -a: WAN=eth0        -c/-d/-h69k: WAN=eth0
#     2025 固件（fw29new）   opc-h68k:           WAN=eth1
#   本仓库按「机型出货年代」保留差异：-c 用 2022 值（WAN=eth1），
#   -d / -new 用 2023 值（WAN=eth0）。⚠️ 实机请用 `ip -br a` 确认哪个口是 WAN。

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

rockchip_setup_interfaces() {
	local board="$1"

	case "$board" in

	# ======================= RK3568 =======================

	# ---- H68K A/B（2022 双千兆，仅 2 口）----
	hinlink,opc-h68k-a|\
	hinlink,opc-h68k-a-usb|\
	linkstar,opc-h68k-a)
		ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
		;;

	# ---- H68K C/D/F（2022 四网口，2×RTL8125）：WAN = eth1 ----
	hinlink,opc-h68k-c|\
	hinlink,opc-h68k-c-usb|\
	hinlink,opc-h68k-c-usb3|\
	linkstar,opc-h68k-c|\
	hinlink,h68k|\
	linkstar,h68k)
		ucidef_set_interfaces_lan_wan 'eth0 eth2 eth3' 'eth1'
		;;

	# ---- H68K D（2023.4 推荐版）/ H68K new：WAN = eth0 ----
	hinlink,opc-h68k-d|\
	hinlink,opc-h68k-d-usb|\
	linkstar,opc-h68k-d|\
	hinlink,opc-h68k-new)
		ucidef_set_interfaces_lan_wan 'eth1 eth2 eth3' 'eth0'
		;;

	# ---- H69K（三网口）：板载 = gmac1(eth0)，2×PCIe 2.5G = eth1/eth2 ----
	hinlink,opc-h69k|\
	hinlink,h69k)
		ucidef_set_interfaces_lan_wan 'eth1 eth2' 'eth0'
		;;

	# ---- H69K-mini（四网口 = H68K max）----
	hinlink,opc-h69k-mini)
		ucidef_set_interfaces_lan_wan 'eth1 eth2 eth3' 'eth0'
		;;

	# ---- H66K：两个 GMAC 都 disabled（厂商 2024 dtb 实证），
	#      只有 2 路 PCIe RTL8125 ⇒ eth0/eth1 都是 PCIe 口 ----
	hinlink,opc-h66k|\
	hinlink,h66k)
		ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
		;;

	# ======================= RK3528 =======================

	# ---- H28K：双口 ----
	#   eth0 = 板载 RTL8211F RGMII 千兆（gmac1）
	#   eth1 = PCIe RTL8111H 千兆（PCI 枚举产生，DT 里不写网卡节点）
	hinlink,opc-h28k|\
	hinlink,h28k|\
	hlink,h28k|\
	linkstar,h28k|\
	linkstar,opc-h28k)
		ucidef_set_interfaces_lan_wan 'eth0' 'eth1'
		;;

	# ---- H29K 全系：单口（厂商 dtb 实证 gmac0 disabled、无 PCIe 网卡）----
	hinlink,opc-h29k|\
	hinlink,h29k|\
	hinlink,h29k-v1.3-114|\
	hinlink,h29k-v1.3-1.14|\
	hinlink,h29k-v5-114|\
	hinlink,h29k-v5-1.14|\
	hinlink,h29k-v5-149|\
	hinlink,h29k-v5-1.49)
		ucidef_set_interfaces_lan_wan 'eth0'
		;;

	# ---- HT2：单口（厂商 dtb 实证 gmac1、无 PCIe 网卡）----
	hinlink,opc-ht2|\
	hinlink,ht2|\
	hlink,ht2)
		ucidef_set_interfaces_lan_wan 'eth0'
		;;

	# ======================= RK3588 =======================

	# ---- H88K v2：两网口（gmac0=eth0 + pcie2x1l1=eth1）----
	# pcie3x4 是 PCIe x4 插槽位（插扩展网卡/NVMe），不算板载口
	hinlink,h88k-v2)
		ucidef_set_interfaces_lan_wan 'eth1' 'eth0'
		;;

	# ---- H88K v3：三网口（v2 两口 + pcie2x1l2 第三颗 RTL8125）----
	hinlink,h88k-v3)
		ucidef_set_interfaces_lan_wan 'eth1 eth2' 'eth0'
		;;

	# ---- H89K：三口（gmac0=eth0 + 2×RTL8125=eth1/eth2）----
	# 厂商固件 02_network 原值：hinlink,h89k -> LAN "eth0 eth1" / WAN "eth2"
	hinlink,opc-h89k|\
	hinlink,h89k)
		ucidef_set_interfaces_lan_wan 'eth0 eth1' 'eth2'
		;;

	esac
}

generate_mac_from_mmc() {
	local sd_hash=$(sha256sum /sys/class/block/mmcblk*/device/cid | head -n 1)
	local mac_base=$(macaddr_canonicalize "$(echo "${sd_hash}" | dd bs=1 count=12 2>/dev/null)")
	echo "$(macaddr_unsetbit_mc "$(macaddr_setbit_la "${mac_base}")")"
}

rockchip_setup_macs() {
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in

	# ---- 全部 HinLink 机型：从 eMMC 的 CID 生成稳定 MAC ----
	#   mmcblk0 必须是 **eMMC**（见各 DTS 的 mmc0 alias），
	#   否则会拿 TF 卡的 CID，换卡就换 MAC。
	hinlink,opc-h68k-a|\
	hinlink,opc-h68k-a-usb|\
	hinlink,opc-h68k-c|\
	hinlink,opc-h68k-c-usb|\
	hinlink,opc-h68k-c-usb3|\
	hinlink,opc-h68k-d|\
	hinlink,opc-h68k-d-usb|\
	hinlink,opc-h68k-new|\
	hinlink,opc-h69k|\
	hinlink,opc-h69k-mini|\
	hinlink,opc-h66k|\
	hinlink,h66k|\
	hinlink,h68k|\
	linkstar,h68k|\
	hinlink,opc-h28k|\
	hinlink,h28k|\
	hlink,h28k|\
	linkstar,h28k|\
	hinlink,opc-h29k|\
	hinlink,h29k|\
	hinlink,h29k-v1.3-114|\
	hinlink,h29k-v5-114|\
	hinlink,h29k-v5-149|\
	hinlink,opc-ht2|\
	hinlink,ht2|\
	hlink,ht2|\
	hinlink,h88k-v2|\
	hinlink,h88k-v3|\
	hinlink,opc-h89k|\
	hinlink,h89k)
		wan_mac=$(macaddr_generate_from_mmc_cid mmcblk0)
		lan_mac=$(macaddr_add "$wan_mac" 1)
		;;

	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac
	[ -n "$label_mac" ] && ucidef_set_label_macaddr $label_mac
}

board_config_update
board=$(board_name)
rockchip_setup_interfaces $board
rockchip_setup_macs $board
board_config_flush

exit 0
