#!/bin/sh /lib/ucode/luci

# HinLink 机型 LED 配置
#
# 每机型独立分支。LED 颜色与 GPIO 来自厂商 dtb 的 gpio-leds / leds 节点。
# ⚠️ 下列 color/label 需按实机确认后调整；未列出的LED 保持默认（常亮或��灭）。


case "$board" in


# ---- H68K A/B（2022 双千兆，2 口）----
# 注：SATA 变体 LED 与基础版相同，仅 combphy0 用途不同

hinlink,opc-h68k-a|\
	hinlink,opc-h68k-a-sata|\
	linkstar,opc-h68k-a)
	ucidef_set_led_default "power" "POWER" "green:work" "1"
	ucidef_set_led_netdev "wan" "WAN" "blue:net" "eth0"
	;;

# ---- H68K C/D/F（2022 四网口）----

hinlink,opc-h68k-c|\
	hinlink,opc-h68k-c-sata|\
	linkstar,opc-h68k-c)
	ucidef_set_led_netdev "wan" "WAN" "blue:net" "eth3"
	ucidef_set_led_ide "disk" "DISK" "yellow:disk"
	;;

# ---- H68K C USB3（2022.4 网口 + USB3.0，本身即USB3 版，无 SATA 变体）----

hinlink,opc-h68k-c-usb3)
	ucidef_set_led_netdev "wan" "WAN" "blue:net" "eth3"
	;;

# ---- H68K D（2023.4 推荐版，WAN = eth0）----

hinlink,opc-h68k-d|\
	hinlink,opc-h68k-d-sata|\
	linkstar,opc-h68k-d)
	ucidef_set_led_netdev "wan" "WAN" "blue:net" "eth0"
	;;

# ---- H68K new（2023末~2024）----
# 不涉及 SATA/USB3 复用，两者可同时使用

hinlink,opc-h68k-new)
	ucidef_set_led_netdev "wan" "WAN" "blue:net" "eth0"
	;;

# ---- H69K（三网口）----
# 不涉及 SATA/USB3 复用

hinlink,opc-h69k)
	ucidef_set_led_netdev "wan" "WAN" "blue:net" "eth0"
	;;

# ---- H69K-mini（四网口= H68K max）----
# 不涉及 SATA/USB3 复用

hinlink,opc-h69k-mini)
	ucidef_set_led_netdev "wan" "WAN" "blue:net" "eth0"
	;;
# ---- H66K ----

hinlink,h66k

	ucidef_set_led_netdev "wan" "WAN" "blue:net" "eth0"

	;;


# ---- H28K ----

hinlink,h28k

	ucidef_set_led_netdev "wan" "WAN" "blue:wan" "eth1"
	ucidef_set_led_netdev "lan" "LAN" "amber:lan" "eth0"

	;;


	*)
		;;
esac

# ---- RK3528 机型 ----

hinlink,opc-h28k|\
	linkstar,h28k)
		ucidef_set_led_netdev "wan" "WAN" "blue:wan" "eth1"
		ucidef_set_led_netdev "lan" "LAN" "amber:lan" "eth0"
		;;

hinlink,opc-h29k|\
	hinlink,h29k-v1.3|\
	hinlink,h29k-v1.3-114|\
	hinlink,h29k-v5|\
	hinlink,h29k-v5-114|\
	hinlink,h29k-v5-1.49|\
	hinlink,h29k-v5-28)
		ucidef_set_led_default "work" "WORK" "green:work" "1"
		;;

hinlink,opc-ht2)
		ucidef_set_led_netdev "lan" "LAN" "amber:lan" "eth0"
		;;

# ---- RK3588 机型 ----

hinlink,h88k-v2|\
	hinlink,h88k-v3)
		ucidef_set_led_netdev "wan" "WAN" "blue:net" "eth0"
		ucidef_set_led_ide "disk" "DISK" "yellow:disk"
		;;
