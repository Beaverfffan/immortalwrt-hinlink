// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * HinLink OPC-H69K (5G)
 *
 * HinLink 适配for immortalwrt —— 每机型独立 DTS，不做自适应。
 *
 * 硬件事实来源：厂商 2024 QWRT R24.07.07 固件 dtb（已解包反编译逐项核对）
 * 蓝本：OpenWrt 主线 rk3568-hinlink-h68k.dts
 *
 * 真·69K：装 USB 5G 模组；屏蔽 1 个 GMAC → 1×GMAC + 2×RTL8125 = 3 口
 *
 * ★ 风扇：PWM0 → pwm-fan，绑定 cpu_thermal。
 *   参数取自 iStoreOS 官方 rk3568-opc-h69k.dts。
 */

/dts-v1/;

#include <dt-bindings/thermal/thermal.h>
#include "rk3568-hinlink-opc.dtsi"

/ {
	model = "HinLink OPC-H69K (5G)";
	compatible = "hinlink,opc-h69k", "rockchip,rk3568";

	aliases {
		ethernet0 = &gmac0;
	};
};
&gmac0 {
	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;
	clock_in_out = "output";
	phy-mode = "rgmii-id";
	phy-supply = <&vcc3v3_sys>;
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
		     &gmac0_tx_bus2
		     &gmac0_rx_bus2
		     &gmac0_rgmii_clk
		     &gmac0_rgmii_bus
		     &gmac0_rstn>;
	snps,reset-gpios = <&gpio2 RK_PD3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	tx_delay = <0x3c>;
	rx_delay = <0x2f>;
	phy-handle = <&rgmii_phy0>;
	status = "okay";
};

&gmac1 {
	status = "disabled";
};

&mdio0 {
	rgmii_phy0: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&mdio1 {
	rgmii_phy1: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&{/} {
	sdio_pwrseq: sdio-pwrseq {
		compatible = "mmc-pwrseq-simple";
		clocks = <&rk809 1>;
		clock-names = "ext_clock";
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_enable>;
		post-power-on-delay-ms = <200>;
		power-off-delay-us = <5000000>;
		reset-gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_LOW>;
	};
};

&{/} {
	vcc3v3_sd_pwr: vcc3v3-sd-pwr {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcc3v3_sd_pwr_en>;
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "vcc3v3_sd_pwr";
		vin-supply = <&vcc5v0_sys>;
	};
};

&sdmmc2 {
	bus-width = <4>;
	cap-sd-highspeed;
	cap-sdio-irq;
	disable-wp;
	keep-power-in-suspend;
	max-frequency = <15000000>;
	mmc-pwrseq = <&sdio_pwrseq>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc2m0_bus4 &sdmmc2m0_cmd &sdmmc2m0_clk>;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	status = "okay";
	vmmc-supply = <&vcc3v3_sys>;
	vqmmc-supply = <&vcc3v3_sd_pwr>;

	sdio_wifi: sdio-wifi@0 {
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PD4 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "host-wake";
		reg = <0>;
	};
};

/*
 * ★ 原&rk809 { ext_32k_clk_out { rockchip,grf = <&rk809_grf 0>; } } 已删除
 *
 *   原因：Linux 6.18 的 rk3568 SoC dtsi 里**没有 rk809 节点，也没有 rk809_grf
 *   标签**（6.18 已把 SoC 拆分到 rk356x-base.dtsi，RK809 PMIC 不在其中）。
 *   保留这段会因 phandle 找不到而**编译失败**。
 *
 *   佐证：6.18 内核自带的 rk3568-hinlink-h68k.dts（官方蓝本）也没有这段。
 *   而本仓库的 rk3568-hinlink-opc.dtsi 与 6.18 内核自带的同名文件
 *   **sha256 完全一致**，说明这份 dtsi 已是上游官方版本 ——
 *   上游没引用 rk809_grf，说明它确实不需要。
 *
 *   这个 32.768kHz 时钟输出是给 RTC 用的；RK3568 板载 RTC 走
 *   hym8563（I2C），不依赖 RK809。若你的机器确实需要它，
 *   应改用 `rk809` 相关的正确写法或另找时钟源。
 */


&pinctrl {
	sdmmc {
		vcc3v3_sd_pwr_en: vcc3v3-sd-pwr-en {
			rockchip,pins = <0 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		sdmmc2m0_bus4: sdmmc2m0-bus4 {
			rockchip,pins =
				<3 RK_PC6 RK_FUNC_3 &pcfg_pull_up_drv_level_2>,
				<3 RK_PC7 RK_FUNC_3 &pcfg_pull_up_drv_level_2>,
				<3 RK_PD0 RK_FUNC_3 &pcfg_pull_up_drv_level_2>,
				<3 RK_PD1 RK_FUNC_3 &pcfg_pull_up_drv_level_2>;
		};

		sdmmc2m0_cmd: sdmmc2m0-cmd {
			rockchip,pins = <3 RK_PD2 RK_FUNC_3 &pcfg_pull_up_drv_level_2>;
		};

		sdmmc2m0_clk: sdmmc2m0-clk {
			rockchip,pins = <3 RK_PD3 RK_FUNC_3 &pcfg_pull_up_drv_level_2>;
		};
	};

	wifi {
		wifi_enable: wifi-enable {
			rockchip,pins = <3 RK_PD5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&{/} {
	/*
	 * 5G 模组供电 —— GPIO0_C0，低有效，3.3V
	 * 取自 iStoreOS rk3568-opc-h69k.dts（与厂商固件一致）。
	 *
	 * ★ startup-delay-us = 2 秒：5G 模组上电后需要时间稳定，
	 *   过早发 AT 命令会失败。这个延时不能随意调小。
	 *
	 * ⚠️ 不要在本文件另加 rfkill-gpio 指向 GPIO0_C0：
	 *   上游 unifreq 的 rk3568-hlink-h69k.dts 确实有
	 *     rfkill_switchs { modem { reset-gpios = <&gpio0 RK_PC0 ...>; }; }
	 *   但那个引脚与本regulator 的 gpio 是**同一个** ——
	 *   两者都是「模组上电/复位」信号，同时配会互相打架
	 *   （regulator 会周期性拉高，rfkill 又想控制它）。
	 *
	 *   本仓库只用 regulator 方式（开机上电、常亮），不做软关机。
	 *   若需要 rfkill 软关机，必须先确认硬件上这脚到底接的是
	 *   「模组 PWRKEY」还是「模组电源开关」—— 两者语义完全不同。
	 *   详见 docs/HARDWARE.md §四。
	 */
	modem_enable: modem-enable {
		compatible = "regulator-fixed";
		enable-active-high;
		gpio = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&modem_enable_en>;
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-name = "modem_enable";
		startup-delay-us = <2000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	/*
	 * ★★ 风扇：PWM0驱动 pwm-fan，绑定 cpu_thermal
	 *
	 * 参数全部来自 iStoreOS 官方 rk3568-opc-h69k.dts，
	 * 并由「h69k-fan」LuCI 插件的 DEVELOPMENT.md 反向验证：
	 *   「pwm-fan cooling-levels = <0 0x55 0x66 0x77 0x88 0x99 0xbb 0xcc 0xff>
	 *     —— 即 0/33/40/47/53/60/73/80/100%，
	 *     与本插件 pct_to_state 的 9 档映射逐值一致」
	 *
	 * ★ cooling-levels 的 9 个值不是随便填的，它就是 h69k-fan 插件
	 *   的 pct_to_state 映射表。改这里会让插件的档位错位。
	 *
	 * ★ 风扇绑定在 cpu_thermal（type 串 cpu-thermal），
	 *   gpu_thermal 没有风扇绑定。
	 *
	 * ★ 设备树无 tach 引脚 → 没有 RPM 反馈，界面只能显示占空比。
	 *
	 * 风扇档位（9 档，与插件一致）：
	 *   0%=0   33%=0x55   40%=0x66   47%=0x77   53%=0x88
	 *   60%=0x99   73%=0xbb   80%=0xcc   100%=0xff
	 */
	fan: pwm-fan {
		compatible = "pwm-fan";
		cooling-levels = <0 0x55 0x66 0x77 0x88 0x99 0xbb 0xcc 0xff>;
		#cooling-cells = <2>;
		fan-supply = <&vcc5v0_sys>;
		pwms = <&pwm0 0 50000 0>;
	};
};

/* 风扇 PWM 通道 */
&pwm0 {
	status = "okay";
};

/*
 * CPU 温控曲线 —— 挂在 fan 上（fan 在上面 cooling-maps 里绑定）
 *
 * iStoreOS 的 active trips（插件 DEVELOPMENT.md 记录的内核默认曲线）：
 *   65℃ -> 2~4 档    85℃ -> 4~6 档    95℃ -> 6 档以上（满档）
 *   20℃ passive -> 最低档常转
 * critical 115℃（插件 raise_trips 上限取 min(105, 115-10)=105℃）
 *
 * ⚠️ 内核 rk356x-base.dtsi 原本的 cpu_thermal 只有 passive 的
 *   cpu_alert0(70℃)/cpu_alert1(75℃) + critical(95℃)，
 *   且 cooling-map0 绑的是 CPU（CPU_FREQ_INCREASE）不是风扇。
 *   下面覆盖为风扇曲线 —— 若要保留 CPU 降频，需把两组 cooling-maps 合并。
 */
&cpu_thermal {
	trips {
		cpu_warm: cpu_warm {
			temperature = <65000>;
			hysteresis = <5000>;
			type = "active";
		};

		cpu_hot: cpu_hot {
			temperature = <85000>;
			hysteresis = <5000>;
			type = "active";
		};

		cpu_hall: cpu_hall {
			temperature = <95000>;
			hysteresis = <5000>;
			type = "active";
		};

		cpu_idle: cpu_idle {
			temperature = <20000>;
			hysteresis = <3000>;
			type = "passive";
		};
	};

	cooling-maps {
		map2 {
			trip = <&cpu_idle>;
			cooling-device = <&fan THERMAL_NO_LIMIT 2>;
		};

		map3 {
			trip = <&cpu_warm>;
			cooling-device = <&fan 2 4>;
		};

		map4 {
			trip = <&cpu_hot>;
			cooling-device = <&fan 4 6>;
		};

		map5 {
			trip = <&cpu_hall>;
			cooling-device = <&fan 6 THERMAL_NO_LIMIT>;
		};
	};
};


&pinctrl {
	modem {
		modem_enable_en: modem-enable-en {
			rockchip,pins = <0 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

&pinctrl {
	gmac {
		gmac0_rstn: gmac0-rstn {
			rockchip,pins = <2 RK_PD3 RK_FUNC_GPIO &pcfg_pull_none>;
		};

		gmac1_rstn: gmac1-rstn {
			rockchip,pins = <1 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};
