// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * HinLink OPC-H89K
 *
 * HinLink 适配 for immortalwrt —— 每机型独立 DTS，不做自适应。
 *
 * ★ 从零移植：H89K 此前在所有 OpenWrt 衍生固件中零适配（2022-2025 年
 *   历次调研均未找到）。本 DTS 全部参数来自厂商 immortalwrt v1.2.2
 *   (2025-06-08) 固件内解出的 dtb（88036 B），逐项核对。
 *
 * 硬件构成（RK3588，厂商 dtb 实证）
 * --------------------------------
 *   网口 = 1×GMAC(fe1b0000, RGMII) + 2×RTL8125 2.5G (PCIe)
 *         GMAC fe1c0000 在厂商 dtb 里 disabled，本机不用。
 *         PCIe 网卡分别挂在 pcie2x1l1(fe180000) 与 pcie2x1l2(fe190000)，
 *         reset 脚分别是 GPIO2_A0 与 GPIO5_A0。
 *
 *   厂商 02_network 映射：LAN "eth0 eth1" / WAN "eth2"
 *         ⇒ 板载 RGMII 作WAN（GMAC 节点显式 label = "eth2"）
 *
 *   显示 = ST7789V 135×240 rot90 @spi@fecb0000 (SPI4 m2)
 *          dc-gpios = GPIO1_A4，屏供电 vcc3v0_lcd (3.0V)
 *   风扇 = pwm3(febf0020)
 *   模组 = 4G/5G 供电（GPIO4_A3）与复位（GPIO4_C6）
 *
 *   ★ SATA：厂商 dtb 里 sata0/1/2 三路**均为 disabled**
 *     （combphy 也未使能），本机不接 SATA 座，故本 DTS 不使能 sata。
 *
 *   ★ 屏参数交叉验证（本 DTS 厂商 dtb 实证 ↔ 上游 unifreq PR#19 独立实证）：
 *     项目          厂商 dtb                      上游 rk3588-hlink-h89k.dts
 *     compatible    sitronix,st7789v             sitronix,st7789v            ✓
 *     分辨率        135 × 240(0x87 × 0xf0)        135 × 240                    ✓
 *     rotate        0x5a = 90                    rotate = <90>                ✓
 *     buswidth      8                            buswidth = <8>               ✓
 *     spi-max-freq  1000000 (1 MHz)              1000000                      ✓
 *     dc-gpios      gpio1 pin4 = GPIO1_A4        <&gpio1 RK_PA4 ACTIVE_HIGH>  ✓
 *     CS            spi4m2_cs0 (GPIO1_B3)        &spi4m2_cs0                 ✓
 *     SPI 引脚      GPIO1_B2/C1/D1 (func8)       由 dtsi 提供                  —
 *     x/y-offset    ★ 厂商 dtb 无此属性          40 / 52                      见下
 *
 *     ⇒ 屏驱动型号、分辨率、旋转、总线宽度、频率、DC 脚、CS 六项**双方完全吻合**，
 *       可确认「上游 PR#19 的 H89K 屏配置可信」。
 *
 *   ★ 关于 x-offset=40 / y-offset=52：这是**上游自己加的**，厂商 dtb 里没有。
 *     它对应 fbtft 的 set_addr_win 偏移补偿 —— ST7789V 135×240 面板在
 *     rotate=90 后显存窗口需要平移才能对上实际可见区。
 *     本仓库已有的 `9999-fbtft-adjust-display-offset-for-rotation-h29k-1.14.patch`
 *     正是同一机制（1.14 寸也是 135×240，偏移量 rot90 时同为 xs+=40, ys+=52），
 *     两边数值吻合，可交叉印证。
 *
 *   ⚠️ 上游 PR#19 的 h89k 文件里 `compatible = "hlink,h88k"` 且
 *     `model = "Hlink H88K"` —— 明显是从 h88k-v3 复制粘贴后忘了改，
 *     导致 H89K / H88K / H88K-v3 三者 compatible 完全相同、无法区分。
 *     本 DTS 使用独立 compatible `hinlink,opc-h89k`，勿沿用上游写法。
 *
 * 枚举顺序（immortalwrt 6.18 dtc 顺序）
 * ------------------------------------
 *   GMAC 是 SoC 内部控制器，枚举固定 => eth0
 *   PCIe 网卡按 bus 扫描顺序        => eth1 / eth2
 *
 *   ⚠️ GMAC 节点在厂商 dtb 里 label = "eth2"，与 dtc 枚举的 eth0 不一致。
 *     本方案沿用厂商 02_network 的映射（LAN eth0 eth1 / WAN eth2），
 *     与出厂固件行为一致。
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

#include "rk3588.dtsi"

/ {
	model = "HINLINK OPC-H89K Board";
	compatible = "hinlink,opc-h89k", "rockchip,rk3588";

	chosen {
		stdout-path = "serial2:1500000n8";
	};

	/* ---- 板载供电（厂商 dtb 的 regulator-fixed 节点） ---- */
	vcc_5v0_sys: vcc-5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	vcc3v3_modem: vcc-3v3-modem {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_modem";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
	};

	/* ---- 4G / 5G 模组：H89K 的标志性特征 ---- */
	modem_power: modem-power {
		compatible = "regulator-fixed";
		regulator-name = "modem_power";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc_5v0_sys>;
		gpio = <&gpio4 RK_PA3 GPIO_ACTIVE_LOW>;
	};

	modem_reset: modem-reset {
		compatible = "regulator-fixed";
		regulator-name = "modem_reset";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc3v3_modem>;
		gpio = <&gpio4 RK_PC6 GPIO_ACTIVE_LOW>;
	};

	/* 屏供电（厂商 dtb 原值 3.0V，always-on） */
	vcc3v0_lcd: vcc3v0-lcd {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v0_lcd";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		vin-supply = <&vcc_5v0_sys>;
	};
};

/* ============================================================
 * 网口 1/3：GMAC(RGMII) —— 板载口，厂商标为 WAN
 * ============================================================ */

&gmac0 {
	clock_in_out = "output";
	phy-mode = "rgmii";
	/* 厂商 dtb 原值 */
	tx_delay = <0x42>;
	rx_delay = <0x34>;
	snps,reset-gpio = <&pinctrl RK_PB3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	phy-handle = <&rgmii_phy0>;

	pinctrl-names = "default";
	/* 厂商 dtb 原值：GPIO2_A6/A7/B1/B2 数据 + GPIO2_B0/B3 时钟 */
	pinctrl-0 = <&gmac0_miim
		     &gmac0_rgmii_bus
		     &gmac0_rgmii_clk
		     &gmac0_tx_bus2
		     &gmac0_rx_bus2>;

	label = "eth2";
	status = "okay";
};

&gmac1 {
	status = "disabled";
};

&mdio0 {
	rgmii_phy0: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

/* ============================================================
 * 网口 2/3 与 3/3：2×RTL8125 2.5G 走 PCIe
 *   厂商 dtb 在这两个控制器下各挂一个 pci10ec,8125
 * ============================================================ */

&pcie2x1l1 {
	reset-gpios = <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>;
	max-link-speed = <2>;              /* Gen2 = 5 GT/s，厂商原值 */
	status = "okay";

	pcie2-0 {
		compatible = "pci10ec,8125";
		reset-gpios = <&gpio2 RK_PA0 GPIO_ACTIVE_LOW>;
	};
};

&pcie2x1l2 {
	reset-gpios = <&gpio5 RK_PA0 GPIO_ACTIVE_LOW>;
	max-link-speed = <2>;
	status = "okay";

	pcie2-1 {
		compatible = "pci10ec,8125";
		reset-gpios = <&gpio5 RK_PA0 GPIO_ACTIVE_LOW>;
	};
};

/* ============================================================
 * 引脚（全部为厂商 dtb 原值）
 * ============================================================ */

&pinctrl {
	gmac {
		gmac0_miim: gmac0-miim {
			rockchip,pins = <4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>,
					<4 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		gmac0_rgmii_bus: gmac0-rgmii-bus {
			rockchip,pins = <2 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PB2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		gmac0_rgmii_clk: gmac0-rgmii-clk {
			rockchip,pins = <2 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PB3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		gmac0_tx_bus2: gmac0-tx-bus2 {
			rockchip,pins = <2 RK_PB6 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PC0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		gmac0_rx_bus2: gmac0-rx-bus2 {
			rockchip,pins = <2 RK_PC1 RK_FUNC_GPIO &pcfg_pull_none>,
					<2 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>,
					<4 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	led {
		led_work_en: led-work-en {
			rockchip,pins = <0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		led_net_en: led-net-en {
			rockchip,pins = <2 RK_PC3 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		led_sata_en: led-sata-en {
			rockchip,pins = <2 RK_PC5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		led_user_en: led-user-en {
			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	ir {
		ir_int_pin: ir-int-pin {
			rockchip,pins = <0 RK_PD4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	spi4 {
		lcd_dc_pin: lcd-dc-pin {
			rockchip,pins = <1 RK_PA4 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
};

/* ============================================================
 * 板载器件
 * ============================================================ */

/* 风扇 PWM（厂商 dtb 里 pwm@febf0020 为 okay）*/
&pwm3 {
	status = "okay";
};

/* ============================================================
 * 屏：ST7789V 135×240 rot90 走 SPI4 m2
 * 全部为厂商 dtb 原值，并经上游 unifreq PR#19 独立交叉验证
 * ============================================================ */

&spi4 {
	assigned-clocks = <&cru CLK_SPI4>;
	assigned-clock-rates = <200000000>;
	num-cs = <1>;
	pinctrl-names = "default";
	pinctrl-0 = <&spi4m2_pins>, <&spi4m2_cs0>;
	status = "okay";

	panel@0 {
		compatible = "sitronix,st7789v";
		reg = <0>;
		rotate = <90>;
		width = <135>;
		height = <240>;
		buswidth = <8>;
		spi-max-frequency = <1000000>;
		spi-cpol;
		spi-cpha;
		dc-gpios = <&gpio1 RK_PA4 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcd_dc_pin>;
		power-supply = <&vcc3v0_lcd>;
	};
};

/* ============================================================
 * ★ 未配置项（厂商 dtb 中同样未启用，不擅自添加）
 *
 *   SATA  —— 厂商 dtb 里 sata0/1/2 与 combphy 均 disabled，本机无 SATA 座
 *   RTC   —— 厂商 dtb 有 hym8563-int 引脚（GPIO0_B2）但无 rtc 节点
 *   红外  —— 厂商 dtb 有 ir-int-pin（GPIO0_D4）引脚定义，
 *            但未见 gpio-ir-receiver 节点，故本 DTS 不使能
 *
 * ★ 屏的显示偏移：需配合 fbtft 偏移补偿 patch 使用，见文件头注释。
 *   厂商 dtb 的 panel 节点**没有** x-offset/y-offset 属性，
 *   偏移由内核 fbtft 驱动侧硬编码（对应本仓库 patches/ 下 1.14 寸那份）。
 * ============================================================ */
