  DEVICE_PACKAGES += kmod-r8169
endef
TARGET_DEVICES += hinlink_opc-h68k-c-usb

# ---- H68K 老机器：c-usb3（2022.8，本身即USB3.0 改型，不再拆）----

define Device/hinlink_opc-h68k-c-usb3
  $(Device/hinlink_opc-h68k-c-usb)
  DEVICE_MODEL := OPC-H68K c-usb3 (2022.8, USB3.0)
