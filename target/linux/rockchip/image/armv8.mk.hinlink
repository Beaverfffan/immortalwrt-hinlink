
# ===== HinLink 全机型（每机型独立，不做自适应） =====


define Device/hinlink_h6xk_base

  $(Device/rk3568)

  DEVICE_VENDOR := HINLINK

  DEVICE_PACKAGES := kmod-ata-ahci-dwc kmod-r8169 wpad-basic-mbedtls

endef


# M.2 (PCIe) 无线模块机型

define Device/hinlink_h6xk_m2_wifi

  $(Device/hinlink_h6xk_base)

  DEVICE_PACKAGES += kmod-mt7921e

endef


# 板载 SDIO 无线（AIC8800，全新机器）

define Device/hinlink_h6xk_sdio_aic8800

  $(Device/hinlink_h6xk_base)

  DEVICE_PACKAGES += kmod-aic8800s

endef


# 板载 SDIO 无线（AP6256，老机器 Broadcom brcmfmac）

define Device/hinlink_h6xk_sdio_ap6256

  $(Device/hinlink_h6xk_base)

  DEVICE_PACKAGES += kmod-brcmfmac kmod-firmware-brcm80211

endef


define Device/hinlink_opc-h68k-a

  $(Device/hinlink_h6xk_sdio_ap6256)

  DEVICE_MODEL := H68K A/B

  DEVICE_ALT0_VENDOR := LinkStar

  DEVICE_ALT0_MODEL := H68K A/B

  DEVICE_DTS := rk3568-hinlink-h68k-a

  UBOOT_DEVICE_NAME := hinlink-h68k-a-rk3568

endef

TARGET_DEVICES += hinlink_opc-h68k-a


define Device/hinlink_opc-h68k-c

  $(Device/hinlink_h6xk_m2_wifi)

  DEVICE_MODEL := H68K C/D/F

  DEVICE_ALT0_VENDOR := LinkStar

  DEVICE_ALT0_MODEL := H68K C/D/F

  DEVICE_DTS := rk3568-hinlink-h68k-c

  UBOOT_DEVICE_NAME := hinlink-h68k-c-rk3568

endef

TARGET_DEVICES += hinlink_opc-h68k-c


define Device/hinlink_opc-h68k-c-usb3

  $(Device/hinlink_h6xk_m2_wifi)

  DEVICE_MODEL := H68K C USB3

  DEVICE_ALT0_VENDOR := LinkStar

  DEVICE_ALT0_MODEL := H68K C USB3

  DEVICE_DTS := rk3568-hinlink-h68k-c-usb3

  UBOOT_DEVICE_NAME := hinlink-h68k-c-usb3-rk3568

endef

TARGET_DEVICES += hinlink_opc-h68k-c-usb3


define Device/hinlink_opc-h68k-d

  $(Device/hinlink_h6xk_m2_wifi)

  DEVICE_MODEL := H68K D

  DEVICE_ALT0_VENDOR := LinkStar

  DEVICE_ALT0_MODEL := H68K D

  DEVICE_DTS := rk3568-hinlink-h68k-d

  UBOOT_DEVICE_NAME := hinlink-h68k-d-rk3568

endef

TARGET_DEVICES += hinlink_opc-h68k-d


define Device/hinlink_opc-h68k-new

  $(Device/hinlink_h6xk_sdio_aic8800)

  DEVICE_MODEL := H68K (2023 new board)

  DEVICE_ALT0_VENDOR := LinkStar

  DEVICE_ALT0_MODEL := H68K

  DEVICE_DTS := rk3568-hinlink-h68k-new

  UBOOT_DEVICE_NAME := hinlink-h68k-new-rk3568

endef

TARGET_DEVICES += hinlink_opc-h68k-new


define Device/hinlink_opc-h69k

  $(Device/hinlink_h6xk_sdio_aic8800)

  DEVICE_MODEL := H69K (5G)

  DEVICE_DTS := rk3568-hinlink-h69k

  UBOOT_DEVICE_NAME := hinlink-h69k-rk3568

  DEVICE_PACKAGES += kmod-hwmon-pwmfan kmod-usb-serial-option

endef

TARGET_DEVICES += hinlink_opc-h69k


define Device/hinlink_opc-h69k-mini

  $(Device/hinlink_h6xk_m2_wifi)

  DEVICE_MODEL := H69K mini

  DEVICE_DTS := rk3568-hinlink-h69k-mini

  UBOOT_DEVICE_NAME := hinlink-h69k-mini-rk3568

endef

TARGET_DEVICES += hinlink_opc-h69k-mini

# ===== RK3528 机型 =====

define Device/hinlink_h28k_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := OPC-H28K
  DEVICE_ALT0_VENDOR := LinkStar
  DEVICE_ALT0_MODEL := H28K
  DEVICE_DTS := rk3528-hinlink-h28k
  UBOOT_DEVICE_NAME := hinlink-h28k-rk3528
  DEVICE_PACKAGES := kmod-r8169
endef
TARGET_DEVICES += hinlink_h28k_rk3528

# ===== H29K：v1.3 与 v5 硬分叉，各自独立 target =====
#
# 用户明确要求：v1.3 与 v5 分开 target，且每种屏幕大小独立机型，不做自适应。
# 命名规则：h29k + 主板版本 + 屏幕大小
#
# ---- v1.3 目标（TARGET_H29K_V13）----
#   硬件特征：无电池电压ADC、无红外接收、模组有 power-gpios(gpio4_B5)、无 &uart2
#   屏幕驱动：ST7789V（1.9" / 1.14"）
#   内核 patch：1.9" 与 1.14" 各需不同 fbtft 偏移
#
#   机型 compatible         屏幕          板级屏参数
#   h29k-v1.3-1.14hinlink,h29k-v1.3-114 135x240 rot270
#   h29k-v1.3-1.9           hinlink,h29k-v1.3     170x320 rot270
#
# ---- v5 目标（TARGET_H29K_V5）----
#   硬件特征：有电池电压ADC(saradc ch1)、有红外(gpio4_PC6)、有 &uart2、模组无 power-gpios
#   屏幕驱动：1.9"/1.14"/2.8" 为 ST7789V；1.49" 触屏版为 GC9307 + AXS5106 + PWM 背光
#
#   机型                compatible               屏幕         板级屏参数
#   h29k-v5-1.14  hinlink,h29k-v5-114  135x240 rot90
#   h29k-v5-1.49  hinlink,h29k-v5-149  172x320 rot270  GC9307 + AXS5106 + pwm3 背光
#   h29k-v5-1.9   hinlink,h29k-v5      170x320 rot270
#   h29k-v5-2.8   hinlink,h29k-v5-28   240x320 rot270

# --- v1.3 目标 ---

define Device/hinlink_h29k-v1.3-1.14_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := H29K v1.3 (1.14 inch)
  DEVICE_DTS := rk3528-hinlink-h29k-v1.3-1.14
  UBOOT_DEVICE_NAME := generic-rk3528
  DEVICE_PACKAGES := kmod-aic8800s kmod-fb-tft-st7789v kmod-r8169
endef
TARGET_DEVICES += hinlink_h29k-v1.3-1.14_rk3528

define Device/hinlink_h29k-v1.3-1.9_rk3528
  $(Device/hinlink_h29k-v1.3-1.14_rk3528)
  DEVICE_MODEL := H29K v1.3 (1.9 inch)
  DEVICE_DTS := rk3528-hinlink-h29k-v1.3-1.9
endef
TARGET_DEVICES += hinlink_h29k-v1.3-1.9_rk3528

# --- v5 目标 ---

define Device/hinlink_h29k-v5-1.14_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := H29K v5 (1.14 inch)
  DEVICE_DTS := rk3528-hinlink-h29k-v5-1.14
  UBOOT_DEVICE_NAME := generic-rk3528
  DEVICE_PACKAGES := kmod-aic8800s kmod-fb-tft-st7789v kmod-r8169 \
                     kmod-iio-adc-rk3528 kmod-power-supply
endef
TARGET_DEVICES += hinlink_h29k-v5-1.14_rk3528

define Device/hinlink_h29k-v5-1.9_rk3528
  $(Device/hinlink_h29k-v5-1.14_rk3528)
  DEVICE_MODEL := H29K v5 (1.9 inch)
  DEVICE_DTS := rk3528-hinlink-h29k-v5-1.9
endef
TARGET_DEVICES += hinlink_h29k-v5-1.9_rk3528

define Device/hinlink_h29k-v5-2.8_rk3528
  $(Device/hinlink_h29k-v5-1.14_rk3528)
  DEVICE_MODEL := H29K v5 (2.8 inch)
  DEVICE_DTS := rk3528-hinlink-h29k-v5-2.8
endef
TARGET_DEVICES += hinlink_h29k-v5-2.8_rk3528

# 1.49 寸电容触屏版：GC9307 屏 + AXS5106 触控 + PWM 背光
define Device/hinlink_h29k-v5-1.49_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := H29K v5 (1.49 inch touch)
  DEVICE_DTS := rk3528-hinlink-h29k-v5-1.49
  UBOOT_DEVICE_NAME := generic-rk3528
  DEVICE_PACKAGES := kmod-aic8800s kmod-fb-tft-gc9307 kmod-r8169 \
                     kmod-iio-adc-rk3528 kmod-power-supply \
                     kmod-input-chipone-axs5106 kmod-i2c-chipone-axs5106
endef
TARGET_DEVICES += hinlink_h29k-v5-1.49_rk3528

define Device/hinlink_opc-ht2_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := OPC-HT2
  DEVICE_DTS := rk3528-hinlink-ht2
  UBOOT_DEVICE_NAME := hinlink-ht2-rk3528
  DEVICE_PACKAGES := kmod-aic8800s kmod-r8169
endef
TARGET_DEVICES += hinlink_opc-ht2_rk3528

# ===== RK3588 机型 =====

define Device/hinlink_h88k_v2
  $(Device/rk3588)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := OPC-H88K V2
  DEVICE_ALT0_VENDOR := LinkStar
  DEVICE_ALT0_MODEL := H88K
  DEVICE_DTS := rk3588-hinlink-h88k-v2
  UBOOT_DEVICE_NAME := hinlink-h88k-rk3588
  DEVICE_PACKAGES := kmod-r8169 kmod-nvme
endef
TARGET_DEVICES += hinlink_h88k_v2

define Device/hinlink_h88k_v3
  $(Device/hinlink_h88k_v2)
  DEVICE_MODEL := OPC-H88K V3
  DEVICE_DTS := rk3588-hinlink-h88k-v3
  DEVICE_PACKAGES += kmod-fb-tft-st7789v
endef
TARGET_DEVICES += hinlink_h88k_v3
