
# ===== HinLink 全机型（每机型独立，不做自适应） =====


define Device/hinlink_h6xk_base

  $(Device/rk3568)

  DEVICE_VENDOR := HINLINK

  DEVICE_PACKAGES := kmod-ata-ahci-dwc kmod-r8169 wpad-basic-mbedtls

endef


# M.2 (PCIe) 无线模块机型

define Device/hinlink_h6xk_m2_wifi

  $(Device/hinlink_h6xk_base)

  DEVICE_PACKAGES += kmod-mt7921e

endef


# 板载 SDIO 无线（AIC8800，全新机器）

define Device/hinlink_h6xk_sdio_aic8800

  $(Device/hinlink_h6xk_base)

  DEVICE_PACKAGES += kmod-aic8800s

endef


# 板载 SDIO 无线（AP6256，老机器 Broadcom brcmfmac）

define Device/hinlink_h6xk_sdio_ap6256

  $(Device/hinlink_h6xk_base)

  DEVICE_PACKAGES += kmod-brcmfmac kmod-firmware-brcm80211

endef


# ===== H68K / H69K（RK3568）=====
#
# ★ SATA / USB3.0 二选一（用户确认，仅 2022-2023 老机器）
#
#   RK3568 硬件复用（rk3568.dtsi 实证）：
#       sata0   phys = <&combphy0 PHY_TYPE_SATA>    (phy@fe820000)
#       USB3.0  同样需要 combphy0 作 PHY_TYPE_USB3
#       combphy 同一时刻只能是一种 PHY_TYPE  =>  SATA 与 USB3.0 互斥
#
#   ⇒ 老机器（68k 的 a-b / c / d）必须拆两个 target：
#       基础版（USB3.0）：&sata0 disabled
#       -sata 版：       &sata0 okay，USB3.0 不可用
#
#   ★ 该复用只涉及 2022-2023 老机器。
#     新机 h68k-new 与 h69k 系不涉及，SATA 与 USB3.0 可同时使用。
#   ★ 网口数量不受影响：2.5G 网卡走独立的 pcie30phy（phy@fe8c0000），
#     与 combphy0 无关。
#
# ★ H69K 型号谱系（用户确认）
#   H69K三网口 = 1×GMAC(gmac0) + 2×RTL8125 2.5G        =>屏蔽 gmac1
#   H69K-mini  四网口 = 2×GMAC(gmac0+gmac1) + 2×RTL8125  => 不屏蔽 gmac1
#   H69K-mini 即 H68K max，两者网络构成相同。
#   原「双网口 h69k-mini」与「H69K-mini 只 3 口」都是臆造，已两次修正。
#
#   枚举顺序：gmac0->eth0  gmac1->eth1  rtl8125_1->eth2  rtl8125_2->eth3
#   四网口机型统一 WAN=eth0（板载 gmac0），LAN=eth1 eth2 eth3。

# ---- H66K：无板载网口（两个 GMAC 均 disabled）----
# 来源 lede rk3568-opc-h66k.dts，硬件由厂商 2024 固件 dtb 实证
# 网口：仅 PCIe 2.5G（pcie3x1 / pcie3x2 由公共 dtsi 使能）

define Device/hinlink_opc-h66k
  $(Device/rk3568)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := OPC-H66K
  DEVICE_DTS := rk3568-hinlink-h66k
  UBOOT_DEVICE_NAME := generic-rk3568
  DEVICE_PACKAGES := kmod-r8169 kmod-ata-ahci-dwc
endef
TARGET_DEVICES += hinlink_opc-h66k

# ---- H68K 老机器：a-b（2022 双千兆，2 口）----

# ---- H68K 老机器：a-b（2022 双千兆，2 口）----
# ★ 命名遵循各源码约定：无后缀 = SATA，-usb = USB3.0

define Device/hinlink_opc-h68k-a
  $(Device/hinlink_h6xk_sdio_ap6256)
  DEVICE_MODEL := OPC-H68K a-b (2022, SATA)
  DEVICE_DTS := rk3568-hinlink-h68k-a
  UBOOT_DEVICE_NAME := hinlink-h68k-rk3568
  DEVICE_PACKAGES += kmod-ata-ahci-dwc
endef
TARGET_DEVICES += hinlink_opc-h68k-a

define Device/hinlink_opc-h68k-a-usb
  $(Device/hinlink_h6xk_sdio_ap6256)
  DEVICE_MODEL := OPC-H68K a-b (2022, USB3.0)
  DEVICE_DTS := rk3568-hinlink-h68k-a-usb
  UBOOT_DEVICE_NAME := hinlink-h68k-rk3568
endef
TARGET_DEVICES += hinlink_opc-h68k-a-usb

# ---- H68K 老机器：c（2022 四网口）----

