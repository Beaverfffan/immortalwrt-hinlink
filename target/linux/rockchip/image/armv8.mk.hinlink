
# ===== HinLink 全机型（每机型独立，不做自适应） =====


define Device/hinlink_h6xk_base

  $(Device/rk3568)

  DEVICE_VENDOR := HINLINK

  DEVICE_PACKAGES := kmod-ata-ahci-dwc kmod-r8169 wpad-basic-mbedtls

endef


# M.2 (PCIe) 无线模块机型

define Device/hinlink_h6xk_m2_wifi

  $(Device/hinlink_h6xk_base)

  DEVICE_PACKAGES += kmod-mt7921e

endef


# 板载 SDIO 无线（AIC8800，全新机器）

define Device/hinlink_h6xk_sdio_aic8800

  $(Device/hinlink_h6xk_base)

  DEVICE_PACKAGES += kmod-aic8800s

endef


# 板载 SDIO 无线（AP6256，老机器 Broadcom brcmfmac）

define Device/hinlink_h6xk_sdio_ap6256

  $(Device/hinlink_h6xk_base)

  DEVICE_PACKAGES += kmod-brcmfmac kmod-firmware-brcm80211

endef


# ===== H68K / H69K（RK3568）=====
#
# ★ SATA / USB3.0 二选一（用户确认，仅 2022-2023 老机器）
#
#   RK3568 硬件复用（rk3568.dtsi 实证）：
#       sata0   phys = <&combphy0 PHY_TYPE_SATA>    (phy@fe820000)
#       USB3.0  同样需要 combphy0 作 PHY_TYPE_USB3
#       combphy 同一时刻只能是一种 PHY_TYPE  =>  SATA 与 USB3.0 互斥
#
#   ⇒ 老机器（68k 的 a-b / c / d）必须拆两个 target：
#       基础版（USB3.0）：&sata0 disabled
#       -sata 版：       &sata0 okay，USB3.0 不可用
#
#   ★ 该复用只涉及 2022-2023 老机器。
#     新机 h68k-new 与 h69k 系不涉及，SATA 与 USB3.0 可同时使用。
#   ★ 网口数量不受影响：2.5G 网卡走独立的 pcie30phy（phy@fe8c0000），
#     与 combphy0 无关。
#
# ★ H69K 型号谱系（用户确认）
#   H69K三网口 = 1×GMAC(gmac0) + 2×RTL8125 2.5G        =>屏蔽 gmac1
#   H69K-mini  四网口 = 2×GMAC(gmac0+gmac1) + 2×RTL8125  => 不屏蔽 gmac1
#   H69K-mini 即 H68K max，两者网络构成相同。
#   原「双网口 h69k-mini」与「H69K-mini 只 3 口」都是臆造，已两次修正。
#
#   枚举顺序：gmac0->eth0  gmac1->eth1  rtl8125_1->eth2  rtl8125_2->eth3
#   四网口机型统一 WAN=eth0（板载 gmac0），LAN=eth1 eth2 eth3。

# ---- H66K：无板载网口（两个 GMAC 均 disabled）----
# 来源 lede rk3568-opc-h66k.dts，硬件由厂商 2024 固件 dtb 实证
# 网口：仅 PCIe 2.5G（pcie3x1 / pcie3x2 由公共 dtsi 使能）

define Device/hinlink_opc-h66k
  $(Device/rk3568)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := OPC-H66K
  DEVICE_DTS := rk3568-hinlink-h66k
  UBOOT_DEVICE_NAME := generic-rk3568
  DEVICE_PACKAGES := kmod-r8169 kmod-ata-ahci-dwc
endef
TARGET_DEVICES += hinlink_opc-h66k

# ---- H68K 老机器：a-b（2022 双千兆，2 口）----

# ---- H68K 老机器：a-b（2022 双千兆，2 口）----
# ★ 命名遵循各源码约定：无后缀 = SATA，-usb = USB3.0

define Device/hinlink_opc-h68k-a
  $(Device/hinlink_h6xk_sdio_ap6256)
  DEVICE_MODEL := OPC-H68K a-b (2022, SATA)
  DEVICE_DTS := rk3568-hinlink-h68k-a
  UBOOT_DEVICE_NAME := hinlink-h68k-rk3568
  DEVICE_PACKAGES += kmod-ata-ahci-dwc
endef
TARGET_DEVICES += hinlink_opc-h68k-a

define Device/hinlink_opc-h68k-a-usb
  $(Device/hinlink_h6xk_sdio_ap6256)
  DEVICE_MODEL := OPC-H68K a-b (2022, USB3.0)
  DEVICE_DTS := rk3568-hinlink-h68k-a-usb
  UBOOT_DEVICE_NAME := hinlink-h68k-rk3568
endef
TARGET_DEVICES += hinlink_opc-h68k-a-usb

# ---- H68K 老机器：c（2022 四网口）----

define Device/hinlink_opc-h68k-c
  $(Device/hinlink_h6xk_m2_wifi)
  DEVICE_MODEL := OPC-H68K c (2022, SATA)
  DEVICE_DTS := rk3568-hinlink-h68k-c
  UBOOT_DEVICE_NAME := hinlink-h68k-rk3568
  DEVICE_PACKAGES += kmod-r8169 kmod-ata-ahci-dwc
endef
TARGET_DEVICES += hinlink_opc-h68k-c

# ★ 2022 C/D/F 的 USB3.0 变体与 2022.8 的 c-usb3 改型，硬件配置完全相同
#   （都是把 SATA 口改成 USB 3.0），已合并为一份 DTS，用两个 compatible 区分：
#     hinlink,opc-h68k-c-usb    2022 C/D/F 的 USB3.0 变体
#     hinlink,opc-h68k-c-usb3   2022.8 的 c-usb3 改型
#   两者 02_network 映射本来就一致（LAN eth0 eth2 eth3 / WAN eth1）。
define Device/hinlink_opc-h68k-c-usb3
  $(Device/hinlink_h6xk_m2_wifi)
  DEVICE_MODEL := OPC-H68K c (2022/2022.8, USB3.0)
  DEVICE_DTS := rk3568-hinlink-h68k-c-usb3
  UBOOT_DEVICE_NAME := hinlink-h68k-rk3568
  DEVICE_PACKAGES += kmod-r8169
endef
TARGET_DEVICES += hinlink_opc-h68k-c-usb3

# ---- H68K 老机器：d（2023.4 推荐版）----

define Device/hinlink_opc-h68k-d
  $(Device/hinlink_h6xk_m2_wifi)
  DEVICE_MODEL := OPC-H68K d (2023.4, SATA)
  DEVICE_DTS := rk3568-hinlink-h68k-d
  UBOOT_DEVICE_NAME := hinlink-h68k-rk3568
  DEVICE_PACKAGES += kmod-r8169 kmod-ata-ahci-dwc
endef
TARGET_DEVICES += hinlink_opc-h68k-d

define Device/hinlink_opc-h68k-d-usb
  $(Device/hinlink_h6xk_m2_wifi)
  DEVICE_MODEL := OPC-H68K d (2023.4, USB3.0)
  DEVICE_DTS := rk3568-hinlink-h68k-d-usb
  UBOOT_DEVICE_NAME := hinlink-h68k-rk3568
  DEVICE_PACKAGES += kmod-r8169
endef
TARGET_DEVICES += hinlink_opc-h68k-d-usb

# ---- H68K 新机器（2023末~2024）：不涉及 SATA/USB3 复用，两者可同时用 ----

define Device/hinlink_opc-h68k-new
  $(Device/hinlink_h6xk_sdio_aic8800)
  DEVICE_MODEL := OPC-H68K new (2023末~2024)
  DEVICE_DTS := rk3568-hinlink-h68k-new
  UBOOT_DEVICE_NAME := hinlink-h68k-rk3568
  DEVICE_PACKAGES += kmod-r8169 kmod-ata-ahci-dwc
endef
TARGET_DEVICES += hinlink_opc-h68k-new

# ---- H69K：三网口 ----

# ---- H69K：三网口 + 5G + PWM 风扇 ----
#★ 风扇：pwm0 驱动 pwm-fan，cooling-levels 9 档
#   （0/33/40/47/53/60/73/80/100%），绑定 cpu_thermal
#   参数取自 iStoreOS 官方 rk3568-opc-h69k.dts，并与「h69k-fan」LuCI 插件
#   的 pct_to_state 映射表逐值一致（该插件依赖此9 档划分，不要改）
#   ⇒ kmod-hwmon-pwmfan 提供 /sys/class/hwmon/hwmonX/pwm1 供用户态读写
#   ⇒ 可选装 iStoreOS 的「h69k-fan」LuCI 插件做曲线温控（纯用户态，
#      不依赖本仓库额外 patch）
# ★ 5G 模组：GPIO0_C0 供电，startup-delay-us = 2 秒（不可调小）

define Device/hinlink_opc-h69k
  $(Device/hinlink_h6xk_sdio_aic8800)
  DEVICE_MODEL := H69K (三网口, 5G, 风扇)
  DEVICE_DTS := rk3568-hinlink-h69k-3eth
  UBOOT_DEVICE_NAME := hinlink-h69k-rk3568
  DEVICE_PACKAGES += kmod-hwmon-pwmfan kmod-usb-serial-option kmod-r8169 \
                     kmod-thermal kmod-hwmon-thermal
endef
TARGET_DEVICES += hinlink_opc-h69k

# ---- H69K-mini：四网口（= H68K max）+ 5G + PWM 风扇 ----
# ★ 风扇配置与 H69K 三口版相同

define Device/hinlink_opc-h69k-mini
  $(Device/hinlink_h6xk_sdio_aic8800)
  DEVICE_MODEL := H69K mini (四网口 = H68K max, 5G, 风扇)
  DEVICE_DTS := rk3568-hinlink-h69k-mini
  UBOOT_DEVICE_NAME := hinlink-h69k-rk3568
  DEVICE_PACKAGES += kmod-hwmon-pwmfan kmod-usb-serial-option kmod-r8169 \
                     kmod-thermal kmod-hwmon-thermal
endef
TARGET_DEVICES += hinlink_opc-h69k-mini

# ===== RK3528 机型 =====

define Device/hinlink_h28k_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := OPC-H28K
  DEVICE_ALT0_VENDOR := LinkStar
  DEVICE_ALT0_MODEL := H28K
  DEVICE_DTS := rk3528-hinlink-h28k
  UBOOT_DEVICE_NAME := hinlink-h28k-rk3528
  # ★ H28K 是**双网口**：
  #     网口1 RTL8211F RGMII 千兆（板载，gmac1）
  #     网口2 RTL8111H  PCIe 千兆（PCI 枚举产生）
  #   依据 HinLink 官网产品页。PCIe 侧网卡不写 pcie-eth 子节点，
  #   靠内核 pcie 驱动枚举自动发现 —— 这也是 kmod-r8169 必须带的原因。
  # ★ H28K **无板载 WiFi**：厂商 dtb 里 /mmc@ffbf0000 带 `no-sdio`，
  #   明确禁用 SDIO（RK3528 的 WiFi 走 sdio0），故不带任何无线驱动。
  # ★ 存储：板载 8G eMMC + TF 卡槽（厂商 dtb：mmc1=eMMC / mmc0=TF卡）
  DEVICE_PACKAGES += kmod-r8169
endef
TARGET_DEVICES += hinlink_h28k_rk3528

# ===== H29K：v1.3 与 v5 硬分叉，各自独立 target =====
#
# 用户明确要求：v1.3 与 v5 分开 target，且每种屏幕大小独立机型，不做自适应。
# 命名规则：h29k + 主板版本 + 屏幕大小
#
# ★ 屏幕尺寸只保留两种：**1.14 寸** 与 **1.49 寸**。
#   厂商的 1.9 寸（170x320）与 2.8 寸（240x320）变体已按需求移除，
#   对应 DTS / target / 02_network 条目一并删除。
#
# ---- v1.3 目标----
#   硬件特征：无电池电压ADC、无红外接收、模组有 power-gpios(gpio4_B5)、无 &uart2
#   屏幕驱动：ST7789V 1.14"
#
#   机型compatible         屏幕          板级屏参数
#   h29k-v1.3-1.14hinlink,h29k-v1.3-114 135x240 rot270
#
# ---- v5 目标----
#   硬件特征：有电池电压ADC(saradc ch1)、有红外(gpio4_PC6)、有 &uart2、模组无 power-gpios
#   屏幕驱动：1.14" 为 ST7789V；1.49" 触屏版为 GC9307 + AXS5106 + PWM 背光
#
#   机型                compatible               屏幕         板级屏参数
#   h29k-v5-1.14  hinlink,h29k-v5-114  135x240 rot90
#   h29k-v5-1.49  hinlink,h29k-v5-149  172x320 rot270  GC9307 + AXS5106 + pwm3 背光

# --- v1.3 目标 ---
# 硬件要点：WiFi AIC8800(sdio0) / 屏 ST7789V 135x240 rot270 / GPIO 恒亮背光
#   ★ 5G 模组 power-gpios = GPIO4_B5（单路，与 v5/H89K 不同）
#   ★ 无电池电压 ADC、无红外接收、无 uart2
#   屏偏移由 patches/9999-fbtft-read-display-offset-from-dt.patch 从 DT 读

define Device/hinlink_h29k-v1.3-1.14_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := H29K v1.3 (1.14 inch)
  DEVICE_DTS := rk3528-hinlink-h29k-v1.3-1.14
  UBOOT_DEVICE_NAME := generic-rk3528
  DEVICE_PACKAGES := kmod-aic8800s kmod-fb-tft-st7789v kmod-r8169
endef
TARGET_DEVICES += hinlink_h29k-v1.3-1.14_rk3528

# --- v5 目标 ---
# 硬件要点：WiFi AIC8800(sdio0) / 屏 ST7789V 135x240 rot90 / GPIO 恒亮背光
#   ★ 有电池电压 ADC(saradc ch1) —— 6.18 上游已原生支持 rk3528-saradc，
#     只需 kmod-iio-adc-rk3528 让用户态能读，不需要任何 patch
#   ★ 有红外接收(gpio4_PC6)、有 uart2(5G 串口)
#   ★ 5G 模组不独立控制供电（与 v1.3 的 GPIO4_B5 不同）
#   屏偏移由 patches/9999-fbtft-read-display-offset-from-dt.patch 从 DT 读

define Device/hinlink_h29k-v5-1.14_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := H29K v5 (1.14 inch)
  DEVICE_DTS := rk3528-hinlink-h29k-v5-1.14
  UBOOT_DEVICE_NAME := generic-rk3528
  DEVICE_PACKAGES := kmod-aic8800s kmod-fb-tft-st7789v kmod-r8169 \
                     kmod-iio-adc-rk3528 kmod-power-supply
endef
TARGET_DEVICES += hinlink_h29k-v5-1.14_rk3528

# 1.49 寸电容触屏版：GC9307 屏 + AXS5106 触控 + PWM 背光
# ★ 全系唯一支持**亮度调节**的机型（pwm-backlight 256 级，pwm3/GPIO4_B6）
# ★ 触控：chipone,axs5106 @I2C1(0x63)，irq=GPIO4_B2、reset=GPIO4_B3
# ⚠️ 172x320 的显示偏移原厂未提供；实测若画面偏移，在 DTS 的 panel 节点
#    加 x-offset / y-offset（配合 9999-...-from-dt.patch）
define Device/hinlink_h29k-v5-1.49_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := H29K v5 (1.49 inch touch)
  DEVICE_DTS := rk3528-hinlink-h29k-v5-1.49
  UBOOT_DEVICE_NAME := generic-rk3528
  DEVICE_PACKAGES := kmod-aic8800s kmod-fb-tft-gc9307 kmod-r8169 \
                     kmod-iio-adc-rk3528 kmod-power-supply \
                     kmod-input-chipone-axs5106 kmod-i2c-chipone-axs5106
endef
TARGET_DEVICES += hinlink_h29k-v5-1.49_rk3528

# HT2：单网口，WiFi AIC8800，★ SDIO 最高速率 SDR50（H29K 是 SDR104）
define Device/hinlink_opc-ht2_rk3528
  $(Device/rk3528)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := OPC-HT2
  DEVICE_DTS := rk3528-hinlink-ht2
  UBOOT_DEVICE_NAME := hinlink-ht2-rk3528
  DEVICE_PACKAGES := kmod-aic8800s kmod-r8169
endef
TARGET_DEVICES += hinlink_opc-ht2_rk3528

# ===== RK3588 机型 =====
#
# ---- H89K：从零移植 ----
# 来源：厂商 immortalwrt v1.2.2 (2025-06-08) 固件内 dtb（88036 B）
#   H89K 此前在所有 OpenWrt 衍生固件中零适配。
#
# 网络 = 1×GMAC(RGMII) + 2×RTL8125 2.5G = 3 口
#   PCIe 网卡挂在 pcie2x1l1(fe180000) 与 pcie2x1l2(fe190000)，
#   reset 脚分别是 GPIO2_A0 与 GPIO5_A0。
#   厂商 02_network 原值：ucidef_set_interfaces_lan_wan "eth0 eth1" "eth2"
#   ⇒ 板载 RGMII 作 WAN（GMAC 节点显式 label = "eth2"）
#
# ★ 不含 SATA —— 厂商 dtb 里 sata0/1/2 三路均为 disabled
# ★ 不含板载 WiFi（用 M.2）
#   5G 模组：4G/5G 供电 GPIO4_A3 + 复位 GPIO4_C6
#   屏：ST7789V 135x240 rot90 @SPI4 m2（厂商 dtb + 上游 unifreq PR#19 双重实证）
#     —— kmod-fb-tft-st7789v 提供驱动；
#     显示偏移由 patches/9999-fbtft-read-display-offset-from-dt.patch
#     从 DT 读取（本 DTS 的 panel 节点已写 x-offset=40 / y-offset=52，
#     值为 H29K 1.14" 同尺寸面板的偏移量，属推断，需实机确认）。
#   5G 模组：双路 IO —— 供电 GPIO4_A3(5V) + 复位 GPIO4_C6(3.3V)
#     ⚠️ 与 H29K 的模组 IO 完全不同，详见 docs/HARDWARE.md §四

define Device/hinlink_opc-h89k_rk3588
  $(Device/rk3588)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := OPC-H89K (3 ports, 5G)
  DEVICE_DTS := rk3588-hinlink-h89k
  UBOOT_DEVICE_NAME := generic-rk3588
  DEVICE_PACKAGES := kmod-r8169 kmod-mt7921e wpad-basic-mbedtls \
                     kmod-hwmon-pwmfan kmod-usb-serial-option \
                     kmod-fb-tft-st7789v
endef
TARGET_DEVICES += hinlink_opc-h89k_rk3588


define Device/hinlink_h88k_v2
  $(Device/rk3588)
  DEVICE_VENDOR := HINLINK
  DEVICE_MODEL := OPC-H88K V2
  DEVICE_ALT0_VENDOR := LinkStar
  DEVICE_ALT0_MODEL := H88K
  DEVICE_DTS := rk3588-hinlink-h88k-v2
  UBOOT_DEVICE_NAME := hinlink-h88k-rk3588
  DEVICE_PACKAGES := kmod-r8169 kmod-nvme
endef
TARGET_DEVICES += hinlink_h88k_v2

define Device/hinlink_h88k_v3
  $(Device/hinlink_h88k_v2)
  DEVICE_MODEL := OPC-H88K V3
  DEVICE_DTS := rk3588-hinlink-h88k-v3
  # ★ 屏走 **spidev + 用户态**（沿用 iStoreOS 的做法）：
  #   DTS 里只有 spidev@0，没有 width/height/rotate 等 fbtft 屏参数，
  #   所以装 fbtft 驱动也没用 —— 屏参数与画面要靠用户态工具加载。
  #   若想改成 fbtft 方案，需在本 DTS 的 spidev@0 旁补 panel 节点
  #   （sitronix,st7789v + 135x240 + rotate + x/y-offset），
  #   并改用 kmod-fb-tft-st7789v。
  DEVICE_PACKAGES += kmod-spi-spidev
endef
TARGET_DEVICES += hinlink_h88k_v3
